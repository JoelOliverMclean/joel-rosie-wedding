generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  username       String @id
  hashedPassword String
}

model Family {
  id            Int      @id @default(autoincrement())
  familyName    String
  rsvpCode      String
  rsvpQuestion  String
  rsvpAnswer    String
  rsvpSubmitted Boolean  @default(false)
  contact       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guests Guest[]
  photos Photo[]
}

model Guest {
  id                Int             @id @default(autoincrement())
  firstName         String
  lastName          String
  child             Boolean         @default(false)
  familyId          Int
  invitedDay        Boolean         @default(false)
  invitedEvening    Boolean         @default(false)
  attendingDay      Boolean         @default(false)
  attendingEvening  Boolean         @default(false)
  allergies         String          @default("")
  foodPreference    FoodPreference?
  rsvpResponse      RSVPResponse?
  highchairRequired Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  family Family @relation(fields: [familyId], references: [id])
}

enum FoodPreference {
  MEAT
  VEGETARIAN
  VEGAN
}

enum RSVPResponse {
  FULL_DAY
  EVENING_ONLY
  NOT_ATTENDING
}

model Photo {
  id         Int         @id @default(autoincrement())
  key        String      @unique
  status     PhotoStatus @default(PENDING)
  familyId   Int?
  caption    String?
  createdAt  DateTime    @default(now())
  reviewedAt DateTime?

  family Family? @relation(fields: [familyId], references: [id])
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}
